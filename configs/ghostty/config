font-family = JetBrainsMono Nerd Font
font-size = 12
adjust-cell-height = 8%

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = none

background-opacity = 0.85
gtk-custom-css = ?blur.css

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

copy-on-select = clipboard
keybind = ctrl+v=paste_from_clipboard
confirm-close-surface = false

# Black/ThinkPad-red default theme. The wallpaper picker writes a matching
# palette to the cache file below, which overrides everything here.
background = #0b0b0b
foreground = #f2f2f2
cursor-color = #e60012
selection-background = #303030
selection-foreground = #ffffff
palette = 0=#181818
palette = 1=#b00018
palette = 2=#8a9a5b
palette = 3=#d89a5b
palette = 4=#6f8da0
palette = 5=#b06a78
palette = 6=#7fa89a
palette = 7=#f2f2f2
palette = 8=#303030
palette = 9=#e60012
palette = 10=#a8b56e
palette = 11=#f0b85e
palette = 12=#8fa9bb
palette = 13=#d08a96
palette = 14=#9fc3b4
palette = 15=#ffffff

config-file = ?~/.cache/reddot/ghostty-colors
