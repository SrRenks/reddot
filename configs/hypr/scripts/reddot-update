#!/bin/sh
# Update engine entry point. The Rust binary is the migrated implementation;
# the Python engine remains as the staged fallback for machines where the extras
# have not built the binary yet.
set -u
rust_engine="$HOME/.local/bin/reddot-update"
python_engine="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/reddot-update.py"

if [ -x "$rust_engine" ]; then
    exec "$rust_engine" "$@"
fi
exec python3 "$python_engine" "$@"
