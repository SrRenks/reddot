#!/bin/sh
# Rust update engine entry point. Python is no longer a runtime fallback.
set -u
rust_engine="${XDG_BIN_HOME:-$HOME/.local/bin}/reddot-update"
[ -x "$rust_engine" ] || {
    echo "reddot-update: $rust_engine is missing; run tools/install-extras.sh" >&2
    exit 127
}
exec "$rust_engine" "$@"
