#!/bin/sh
# Rust palette engine entry point. Python is no longer a runtime fallback.
set -u
rust_engine="${XDG_BIN_HOME:-$HOME/.local/bin}/reddot-wallcolors"
[ -x "$rust_engine" ] || {
    echo "wallcolors: $rust_engine is missing; run tools/install-extras.sh" >&2
    exit 127
}
exec "$rust_engine" "$@"
