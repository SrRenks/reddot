#!/bin/sh
# Wallpaper palette entry point. The Rust binary is the migrated implementation;
# the Python script remains as the staged fallback until the extras build it.
set -u
rust_engine="$HOME/.local/bin/reddot-wallcolors"
python_engine="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/wallcolors.py"

if [ -x "$rust_engine" ]; then
    exec "$rust_engine" "$@"
fi
exec python3 "$python_engine" "$@"
