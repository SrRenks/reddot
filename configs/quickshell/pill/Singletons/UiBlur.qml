pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

/**
 * Independent blur for the pill and every panel (all on the `pill` layer
 * namespace). It never uses the window-blur switch for its own state.
 *
 * Hyprland gates layer blur behind decoration.blur.enabled. To keep panel blur
 * usable while window blur is off, the generated module:
 *   - enables decoration blur only as a prerequisite;
 *   - adds the pill layer rule;
 *   - adds `no_blur` to every ordinary window while window blur is off.
 * Turning window blur on removes the no-blur rule, so both can coexist.
 */
Singleton {
    id: root

    readonly property string path: Quickshell.env("HOME") + "/.config/hypr/modules/ui-blur.lua"
    property bool enabled: false
    property bool loaded: false

    function moduleText(on, windowOn) {
        var text = "-- Generated by the reddot UI; pill/panel layer blur only.\n"
            + "hl.config({ decoration = { blur = { enabled = "
            + ((on || windowOn) ? "true" : "false") + " } } })\n";
        if (on) {
            text += "hl.layer_rule({ name = \"pill-blur\", match = { namespace = \"pill\" }, blur = true, ignore_alpha = 0.5 })\n";
            if (!windowOn)
                text += "hl.window_rule({ name = \"pill-blur-window-noblur\", match = { class = \".*\" }, no_blur = true })\n";
        } else {
            text += "-- Panel blur is off. Window blur follows its own switch.\n";
        }
        return text;
    }

    function sync(windowOn) {
        var w = (windowOn === undefined) ? Flags.windowBlur : windowOn;
        writer.setText(moduleText(enabled, w));
        reload.running = true;
    }

    function refresh() {
        reader.reload();
    }

    function setEnabled(on) {
        enabled = on;
        Flags.pillBlur = on;
        sync(Flags.windowBlur);
    }

    FileView {
        id: reader
        path: root.path
        blockLoading: true
        printErrors: false
        onLoaded: {
            root.enabled = text().indexOf("layer_rule") >= 0 && text().indexOf("pill-blur") >= 0;
            root.loaded = true;
            Flags.pillBlur = root.enabled;
            // Migrate the old one-line module: it enabled no global prerequisite
            // and could not survive a window-blur-off state.
            root.sync(Flags.windowBlur);
        }
    }

    FileView {
        id: writer
        path: root.path
        atomicWrites: true
        printErrors: false
    }

    Process {
        id: reload
        command: ["hyprctl", "reload"]
        stderr: StdioCollector {}
    }

    Component.onCompleted: refresh()
}
