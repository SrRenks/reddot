pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

/**
 * The Quickshell layer blur. It writes the single pill-blur layer rule into its
 * own Lua module, so toggling it never touches decoration.blur (window blur) and
 * therefore never changes Ghostty or any other terminal.
 */
Singleton {
    id: root

    readonly property string path: Quickshell.env("HOME") + "/.config/hypr/modules/ui-blur.lua"
    readonly property string rule: "-- Generated by the reddot UI; Quickshell layer blur only.\n"
        + "hl.layer_rule({ name = \"pill-blur\", match = { namespace = \"pill\" }, blur = true, ignore_alpha = 0.5 })\n"
    readonly property string off: "-- UI blur is off. Enable it in Look or SUPER+SHIFT+F.\n"

    property bool enabled: false
    property bool loaded: false

    function refresh() {
        reader.reload();
    }

    function setEnabled(on) {
        enabled = on;
        Flags.pillBlur = on;
        writer.setText(on ? rule : off);
        reload.running = true;
    }

    FileView {
        id: reader
        path: root.path
        blockLoading: true
        printErrors: false
        onLoaded: {
            root.enabled = text().indexOf("pill-blur") >= 0;
            root.loaded = true;
            Flags.pillBlur = root.enabled;
        }
    }

    FileView {
        id: writer
        path: root.path
        atomicWrites: true
        printErrors: false
    }

    Process {
        id: reload
        command: ["hyprctl", "reload"]
        stderr: StdioCollector {}
    }

    Component.onCompleted: refresh()
}
