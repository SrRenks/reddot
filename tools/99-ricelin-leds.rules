# ThinkPad mute LEDs: let the kernel audio triggers follow ALSA automatically.
# The `add` action only: writing a trigger on every `change` caused a feedback
# loop, because the trigger itself emits change events.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="platform::mute", ATTR{trigger}="audio-mute"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="platform::micmute", ATTR{trigger}="audio-micmute"
