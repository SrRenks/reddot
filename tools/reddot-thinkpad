#!/bin/sh
#
# reddot-thinkpad — read and adjust the ThinkPad-specific sysfs knobs.
#
# Installed only when a ThinkPad is detected. `status` needs no root; the
# setters need root and run through pkexec/polkit.
#
#   status
#   trackpoint <attr> <value>
#   doubletap 0|1
#   led kbd 0..max
#
# Fan control is deliberately absent: thinkfan owns /proc/acpi/ibm/fan on the
# reference machine, and raw writes would either be overwritten or defeat the
# EC watchdog. See docs/THINKPAD.md.

set -eu

SYS="${REDDOT_THINKPAD_SYSFS:-/sys}"
TP="$SYS/devices/platform/thinkpad_acpi"
PROC="${REDDOT_THINKPAD_PROC:-/proc/acpi/ibm/fan}"
THINKFAN_CONF="${REDDOT_THINKPAD_THINKFAN:-/etc/thinkfan.yaml}"
SERIO="${REDDOT_THINKPAD_SERIO:-}"
LEDS="$SYS/class/leds"
HWMON="$SYS/class/hwmon"
TEST="${REDDOT_THINKPAD_TEST:-0}"

die() { echo "$*" >&2; exit 2; }
need_root() {
    [ "$TEST" = "1" ] || [ "$(id -u)" -eq 0 ] || die "root required"
}

read_or() {
    [ -r "$1" ] && cat "$1" 2>/dev/null || true
}

trim() {
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

find_serio() {
    if [ -n "$SERIO" ]; then
        echo "$SERIO"
        return 0
    fi
    for d in "$SYS"/devices/platform/i8042/serio*; do
        if [ -e "$d/sensitivity" ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

temp_of() {
    name=$1
    file=${2:-temp1_input}
    for d in "$HWMON"/hwmon*; do
        [ -r "$d/name" ] || continue
        [ "$(cat "$d/name" 2>/dev/null)" = "$name" ] || continue
        [ -r "$d/$file" ] || continue
        v=$(cat "$d/$file" 2>/dev/null)
        [ -n "$v" ] && echo $((v / 1000))
        return 0
    done
}

led_of() {
    [ -r "$LEDS/$1/brightness" ] && cat "$LEDS/$1/brightness" 2>/dev/null || true
}

cmd_status() {
    if [ ! -d "$TP" ]; then
        echo "PRESENT=0"
        exit 0
    fi
    echo "PRESENT=1"

    model=$(read_or "$SYS/devices/virtual/dmi/id/product_version" | trim)
    bios=$(read_or "$SYS/devices/virtual/dmi/id/bios_version" | trim)
    [ -n "$model" ] && echo "MODEL=$model"
    [ -n "$bios" ] && echo "BIOS=$bios"

    if [ -r "$PROC" ]; then
        speed=$(awk -F':[[:space:]]*' '/^speed:/{print $2; exit}' "$PROC" 2>/dev/null || true)
        level=$(awk -F':[[:space:]]*' '/^level:/{print $2; exit}' "$PROC" 2>/dev/null || true)
        state=$(awk -F':[[:space:]]*' '/^status:/{print $2; exit}' "$PROC" 2>/dev/null || true)
        [ -n "$speed" ] && echo "FAN_RPM=$speed"
        [ -n "$level" ] && echo "FAN_LEVEL=$level"
        [ -n "$state" ] && echo "FAN_STATUS=$state"
    fi

    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet thinkfan 2>/dev/null; then
            echo "THINKFAN=active"
        else
            echo "THINKFAN=inactive"
        fi
    fi

    for pair in "CPU:k10temp:temp1_input" "GPU:amdgpu:temp1_input" \
                "NVME:nvme:temp1_input" "ACPI:acpitz:temp1_input"; do
        key=${pair%%:*}
        rest=${pair#*:}
        chip=${rest%%:*}
        file=${rest##*:}
        v=$(temp_of "$chip" "$file" || true)
        [ -n "$v" ] && echo "TEMP_$key=$v"
    done

    [ -r "$SYS/firmware/acpi/platform_profile" ] && \
        echo "PLATFORM=$(cat "$SYS/firmware/acpi/platform_profile" 2>/dev/null)"

    if [ -r "$THINKFAN_CONF" ]; then
        curve=$(sed -n 's/.*\["level \([0-7]\)",[[:space:]]*\([0-9]\+\),[[:space:]]*\([0-9]\+\)\].*/\1:\2:\3/p' "$THINKFAN_CONF" | paste -sd';' -)
        [ -n "$curve" ] && echo "CURVE=$curve"
    fi

    for pair in "KBD:tpacpi::kbd_backlight" "MICMUTE:platform::micmute" \
                "MUTE:platform::mute" "LIDLOGO:tpacpi::lid_logo_dot" \
                "POWER:tpacpi::power" "STANDBY:tpacpi::standby" \
                "VANTAGE:tpacpi::thinkvantage"; do
        key=${pair%%:*}
        led=${pair#*:}
        v=$(led_of "$led")
        [ -n "$v" ] && echo "LED_$key=$v"
        if [ "$key" = "KBD" ] && [ -r "$LEDS/$led/max_brightness" ]; then
            echo "LED_KBD_MAX=$(cat "$LEDS/$led/max_brightness" 2>/dev/null)"
        fi
    done

    led_spec=""
    led_meta=""
    for d in "$LEDS"/*; do
        [ -r "$d/brightness" ] || continue
        name=${d##*/}
        value=$(cat "$d/brightness" 2>/dev/null || true)
        max=$(cat "$d/max_brightness" 2>/dev/null || echo 1)
        [ -n "$value" ] && led_spec="${led_spec}${name}|${value}|${max};"

        # Trigger metadata is optional: a LED without a trigger file still has
        # brightness. Triggers are space-separated and the current one is [bracketed].
        if [ -r "$d/trigger" ]; then
            trigger_spec=$(cat "$d/trigger" 2>/dev/null || true)
            trigger_now=$(printf '%s\n' "$trigger_spec" | tr ' ' '\n' \
                | sed -n 's/^\[\(.*\)\]$/\1/p' | head -n 1)
            trigger_list=$(printf '%s\n' "$trigger_spec" | tr ' ' '\n' \
                | tr -d '[]' | awk '!seen[$0]++' | paste -sd, -)
            delay_on=$(read_or "$d/delay_on")
            delay_off=$(read_or "$d/delay_off")
            led_meta="${led_meta}${name}|${max}|${value}|${trigger_now}|${trigger_list}|${delay_on}|${delay_off};"
        fi
    done
    [ -n "$led_spec" ] && echo "LEDS=$led_spec"
    [ -n "$led_meta" ] && echo "LED_META=$led_meta"

    # Write-only on kernel: reading returns the accepted language list, not the
    # active code. Expose the list so the UI can still offer the picker.
    if [ -r "$TP/keyboard_lang" ]; then
        langs=$(read_or "$TP/keyboard_lang" | trim)
        [ -n "$langs" ] && echo "KEYBOARD_LANGS=$langs"
    fi
    [ -r "$TP/dytc_lapmode" ] && \
        echo "LAP_MODE=$(read_or "$TP/dytc_lapmode" | trim)"
    for d in /proc/acpi/button/lid/*/state; do
        [ -r "$d" ] || continue
        state=$(read_or "$d" | trim)
        [ -n "$state" ] && { echo "LID_STATE=$state"; break; }
    done
    [ -r "$TP/usb_c_security" ] && \
        echo "USB_C_SECURITY=$(read_or "$TP/usb_c_security" | trim)"

    # Kernel modules that add useful triggers on demand. They are not loaded by
    # probe; selecting one in the UI loads it through the root helper.
    extras=""
    for m in timer heartbeat oneshot pattern; do
        if command -v modinfo >/dev/null 2>&1 && modinfo "ledtrig-$m" >/dev/null 2>&1; then
            extras="${extras}${extras:+,}$m"
        fi
    done
    [ -n "$extras" ] && echo "LED_EXTRA_TRIGGERS=$extras"

    serio=$(find_serio || true)
    if [ -n "$serio" ]; then
        for attr in sensitivity speed press_to_select dragging drift_time inertia; do
            [ -r "$serio/$attr" ] || continue
            key=$(printf '%s' "$attr" | tr 'a-z' 'A-Z')
            echo "TP_$key=$(cat "$serio/$attr" 2>/dev/null)"
        done
    fi

    [ -r "$TP/doubletap_enable" ] && \
        echo "DOUBLETAP=$(cat "$TP/doubletap_enable" 2>/dev/null)"
    if [ -r "$TP/fn_lock" ]; then
        echo "FN_LOCK=$(cat "$TP/fn_lock" 2>/dev/null)"
    fi
}

cmd_trackpoint() {
    [ "$#" -eq 2 ] || die "usage: trackpoint <attr> <value>"
    attr=$1
    value=$2
    case "$value" in ''|*[!0-9]*) die "value is not a number" ;; esac

    case "$attr" in
        sensitivity|speed|inertia) max=255 ;;
        press_to_select|dragging) max=1 ;;
        drift_time) max=2000 ;;
        *) die "unsupported TrackPoint attribute: $attr" ;;
    esac
    [ "$value" -le "$max" ] || die "$attr must be 0..$max"

    serio=$(find_serio) || die "no TrackPoint serio device"
    [ -e "$serio/$attr" ] || die "this TrackPoint has no $attr"
    need_root
    printf '%s\n' "$value" > "$serio/$attr"
}

cmd_doubletap() {
    [ "$#" -eq 1 ] || die "usage: doubletap 0|1"
    case "$1" in 0|1) ;; *) die "doubletap must be 0 or 1" ;; esac
    [ -e "$TP/doubletap_enable" ] || die "doubletap is not exposed on this model"
    need_root
    printf '%s\n' "$1" > "$TP/doubletap_enable"
}

cmd_curve() {
    [ "$#" -eq 2 ] || die "usage: curve set <level:low:high;...>"
    [ "$1" = "set" ] || die "usage: curve set <level:low:high;...>"
    spec=$2
    [ -r "$THINKFAN_CONF" ] || die "thinkfan config not found: $THINKFAN_CONF"
    command -v systemctl >/dev/null 2>&1 || die "systemctl is required"

    oldifs=$IFS
    IFS=';'
    set -- $spec
    IFS=$oldifs
    [ "$#" -eq 8 ] || die "curve needs 8 levels"

    i=0
    oldifs=$IFS
    IFS=';'
    for pair in $spec; do
        level=${pair%%:*}
        rest=${pair#*:}
        low=${rest%%:*}
        high=${rest##*:}
        case "$level" in 0|1|2|3|4|5|6|7) ;; *) IFS=$oldifs; die "bad level: $level" ;; esac
        case "$low" in ''|*[!0-9]*) IFS=$oldifs; die "bad low threshold: $low" ;; esac
        case "$high" in ''|*[!0-9]*) IFS=$oldifs; die "bad high threshold: $high" ;; esac
        [ "$level" -eq "$i" ] || { IFS=$oldifs; die "levels must be 0..7 in order"; }
        [ "$low" -ge 0 ] && [ "$low" -le 100 ] || { IFS=$oldifs; die "low must be 0..100"; }
        [ "$high" -ge 0 ] && [ "$high" -le 100 ] || { IFS=$oldifs; die "high must be 0..100"; }
        [ "$low" -le "$high" ] || { IFS=$oldifs; die "level $level: low is above high"; }
        i=$((i + 1))
    done
    IFS=$oldifs

    need_root
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    awk '/^levels:[[:space:]]*$/{exit} {print}' "$THINKFAN_CONF" > "$tmp"
    printf 'levels:\n' >> "$tmp"
    oldifs=$IFS
    IFS=';'
    for pair in $spec; do
        level=${pair%%:*}
        rest=${pair#*:}
        low=${rest%%:*}
        high=${rest##*:}
        printf '  - ["level %s", %s, %s]\n' "$level" "$low" "$high" >> "$tmp"
    done
    IFS=$oldifs

    backup="$THINKFAN_CONF.reddot.bak"
    [ -e "$backup" ] || cp -p "$THINKFAN_CONF" "$backup"
    cp "$tmp" "$THINKFAN_CONF"
    chmod 0644 "$THINKFAN_CONF"
    if ! systemctl reload thinkfan 2>/dev/null; then
        cp "$backup" "$THINKFAN_CONF"
        die "thinkfan reload failed; previous curve restored"
    fi
}

cmd_fnlock() {
    [ "$#" -eq 1 ] || die "usage: fnlock 0|1"
    case "$1" in 0|1) ;; *) die "fnlock must be 0 or 1" ;; esac
    [ -e "$TP/fn_lock" ] || die "fn_lock is not exposed on this model"
    need_root
    printf '%s\n' "$1" > "$TP/fn_lock"
}

ensure_trigger_module() {
    case "$1" in
        timer|heartbeat|oneshot|pattern)
            command -v modprobe >/dev/null 2>&1 \
                && modprobe "ledtrig-$1" 2>/dev/null || true
            ;;
    esac
}

cmd_led_trigger() {
    [ "$#" -eq 2 ] || die "usage: led-trigger <name> <trigger>"
    name=$1
    trigger=$2
    case "$name" in ''|*[!A-Za-z0-9:_-]*) die "invalid LED name" ;; esac
    case "$trigger" in ''|*[!A-Za-z0-9:_-]*) die "invalid trigger" ;; esac

    dir="$LEDS/$name"
    trigfile="$dir/trigger"
    [ -r "$trigfile" ] || die "LED has no trigger: $name"
    available=$(cat "$trigfile" 2>/dev/null || true)
    if ! printf '%s\n' "$available" | tr ' ' '\n' | tr -d '[]' | grep -Fxq -- "$trigger"; then
        ensure_trigger_module "$trigger"
        available=$(cat "$trigfile" 2>/dev/null || true)
    fi
    if ! printf '%s\n' "$available" | tr ' ' '\n' | tr -d '[]' | grep -Fxq -- "$trigger"; then
        die "trigger not available for $name: $trigger"
    fi
    need_root
    printf '%s\n' "$trigger" > "$trigfile"
}

cmd_led_delay() {
    [ "$#" -eq 3 ] || die "usage: led-delay <name> <on_ms> <off_ms>"
    name=$1
    on=$2
    off=$3
    case "$name" in ''|*[!A-Za-z0-9:_-]*) die "invalid LED name" ;; esac
    case "$on" in ''|*[!0-9]*) die "delay_on is not a number" ;; esac
    case "$off" in ''|*[!0-9]*) die "delay_off is not a number" ;; esac
    [ "$on" -le 10000 ] && [ "$off" -le 10000 ] \
        || die "delay must be 0..10000 ms"
    dir="$LEDS/$name"
    [ -e "$dir/delay_on" ] && [ -e "$dir/delay_off" ] \
        || die "LED has no timer delay files: $name"
    need_root
    printf '%s\n' "$on" > "$dir/delay_on"
    printf '%s\n' "$off" > "$dir/delay_off"
}

cmd_keyboard_lang() {
    [ "$#" -eq 1 ] || die "usage: keyboard-lang <code>"
    code=$1
    case "$code" in ''|*[!a-zA-Z-]*) die "invalid keyboard language" ;; esac
    [ -r "$TP/keyboard_lang" ] || die "keyboard_lang is not exposed on this model"
    available=$(read_or "$TP/keyboard_lang" | trim)
    case " $available " in
        *" $code "*) ;;
        *) die "keyboard language not available: $code" ;;
    esac
    need_root
    printf '%s\n' "$code" > "$TP/keyboard_lang"
}

cmd_led() {
    [ "$#" -eq 2 ] || die "usage: led <name|kbd|lid|vantage> <value>"
    name=$1
    value=$2
    case "$value" in ''|*[!0-9]*) die "value is not a number" ;; esac

    case "$name" in
        kbd) name="tpacpi::kbd_backlight" ;;
        lid|lid_logo) name="tpacpi::lid_logo_dot" ;;
        vantage|thinkvantage) name="tpacpi::thinkvantage" ;;
    esac
    case "$name" in
        ''|*[!A-Za-z0-9:_-]*) die "invalid LED name" ;;
    esac

    dir="$LEDS/$name"
    file="$dir/brightness"
    maxfile="$dir/max_brightness"
    [ -e "$file" ] || die "LED is not exposed: $name"
    max=$(cat "$maxfile" 2>/dev/null || echo 1)
    [ "$value" -le "$max" ] || die "$name must be 0..$max"

    # Aliases keep the old one-bit contract; full names take raw brightness.
    case "$1" in
        lid|lid_logo|vantage|thinkvantage)
            [ "$value" -eq 1 ] && value=$max
            ;;
    esac

    need_root
    printf '%s\n' "$value" > "$file"
}

case "${1:-}" in
    status) cmd_status ;;
    trackpoint) shift; cmd_trackpoint "$@" ;;
    curve) shift; cmd_curve "$@" ;;
    doubletap) shift; cmd_doubletap "$@" ;;
    fnlock) shift; cmd_fnlock "$@" ;;
    led) shift; cmd_led "$@" ;;
    led-trigger) shift; cmd_led_trigger "$@" ;;
    led-delay) shift; cmd_led_delay "$@" ;;
    keyboard-lang) shift; cmd_keyboard_lang "$@" ;;
    *)
        cat >&2 <<'EOF'
usage: reddot-thinkpad {status|trackpoint <attr> <value>|doubletap 0|1|fnlock 0|1|curve set <spec>|led <name> <value>|led-trigger <name> <trigger>|led-delay <name> <on_ms> <off_ms>|keyboard-lang <code>}
EOF
        exit 2
        ;;
esac
